{
  "name": "asset-toolbox-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build:web": "npm run typecheck && vite build",
    "build": "tauri build --no-bundle && node scripts/portable.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test --project=native",
    "test:e2e:network": "playwright test --project=network"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "vue": "^3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24",
    "@vitejs/plugin-vue": "^6",
    "@vue/test-utils": "^2",
    "jsdom": "^26",
    "typescript": "^5.9",
    "vite": "^7",
    "vitest": "~4.1.12",
    "vue-tsc": "^3"
  },
  "overrides": {
    "js-beautify": {
      "glob": "^14.0.2"
    },
    "minimatch": "^11.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "license": "MIT"
}
